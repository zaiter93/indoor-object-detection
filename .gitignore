Indoor Object Detection Dataset/
*.zip
data/raw/
data/interim/
data/processed/

# Training artefacts
runs/
*.pt
!weights/best.pt
predictions/          # 459 files / ~40 MB; ships in submission.zip, not in the repo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Submission bundle (regenerated by scripts/package_submission.py)
submission.zip

# Reference paper (kept locally, not part of the deliverable)
*.pdf

# Results from a training run are TRACKED once published from a finished Colab
# run via scripts/publish_results.py -- the README links to them, so ignoring
# them leaves broken links on GitHub. They are not ignored; this note exists so
# nobody re-adds them. Never commit the local smoke test's output: its numbers
# are meaningless and it has overwritten the real report before.

# Configs generated at runtime (ablation variants, ad-hoc checks)
configs/_*.yaml
